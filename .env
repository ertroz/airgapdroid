# Orchestrator Backend
PORT=4000
WEB_UI_URL=http://localhost:3000

# Container Runtime (Kiri Official first, fallback to Docker)
# Values: auto | kiri | docker
CONTAINER_RUNTIME=auto
KIRI_BINARY=kiri
KIRI_REPO=libracoder/kiri
# Optional (Windows WSL2): Direct URL to a binder-enabled WSL2 kernel (bzImage)
# Used by 1-click Auto-Configure Binder to update %UserProfile%\.wslconfig automatically
WSL_BINDER_KERNEL_URL=https://github.com/ertroz/kiri/releases/download/binder1/bzImage
# Optional (macOS Kiri Official): Direct URL to a binder-enabled Kiri guest kernel (Image for arm64 / bzImage for x64)
# Used by 1-click Auto-Configure Binder with KIRI_GUEST_DIR (keeps Kiri.app Apple signature intact)
MACOS_BINDER_KERNEL_URL=https://github.com/ertroz/kiri/releases/download/binder1/Image
KIRI_GUEST_DIR=
# Automatically stop ws-scrcpy, mitmweb, and Kiri engine on app exit if no other containers are running
AUTO_STOP_KIRI_ON_EXIT=true

# Infrastructure Service Ports
WS_SCRCPY_PORT=8000
MITM_PROXY_PORT=8080
# WAJIB 8082 agar tidak bentrok dengan React Native Metro Bundler (8081)
MITM_WEB_PORT=8082

# Optional: Default host IP reachable from Android container/device for HTTP proxy
# Leave blank for automatic detection (auto-handles Kiri gateway & docker0)
QA_PROXY_HOST=

# Optional: Google Desktop OAuth 2.0 Client ID (PKCE, without client_secret)
# Users can also input this directly in the Firebase Switcher UI
GOOGLE_OAUTH_CLIENT_ID=

# Optional: External commercial license validation endpoint (POST { licenseKey, machineFingerprint })
LICENSE_VALIDATION_URL=

# Optional: Set to true to enable Demo Pro Preview automatically on first boot
QA_DEMO_PRO=false

# Gumroad Commercial License (Production)
GUMROAD_PRODUCT_ID=Jpso-xqnvKSaD5cIPU8ZfQ==
GUMROAD_PRODUCT_PERMALINK=https://ertrozian.gumroad.com/l/yzwkx
GUMROAD_CHECKOUT_URL=https://ertrozian.gumroad.com/l/yzwkx?wanted=true
GUMROAD_MAX_USES=3
GUMROAD_OFFLINE_GRACE_DAYS=7
GUMROAD_REVERIFY_HOURS=24
QA_ALLOW_DEMO_PRO=
