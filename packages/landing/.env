# Optional build-time variables for Cloudflare Pages / Workers / GitHub Actions
# GitHub repository slug hosting AirgapDroid desktop release installers
VITE_GITHUB_REPO=airgapdroid/airgapdroid

# Release version tag (without leading 'v') used for direct installer download links
VITE_RELEASE_VERSION=1.0.0

# Gumroad checkout URL for Pro license CTA buttons
VITE_GUMROAD_URL=https://ertrozian.gumroad.com/l/yzwkx

# Kiri runtime repository URL
VITE_KIRI_REPO=libracoder/kiri
