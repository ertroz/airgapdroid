{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AirgapDroid",
  "version": "1.0.0",
  "identifier": "com.airgapdroid.desktop",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../web-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AirgapDroid",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "theme": "Light",
        "titleBarStyle": "Visible",
        "backgroundColor": "#F7F8FA"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "resources": {
      "../../orchestrator/assets/qa-screen-agent.jar": "assets/qa-screen-agent.jar"
    },
    "externalBin": [
      "binaries/qa-orchestrator",
      "binaries/adb"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
