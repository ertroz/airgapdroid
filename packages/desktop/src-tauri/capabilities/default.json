{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for Local Web QA Studio desktop window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "binaries/qa-orchestrator", "sidecar": true },
        { "name": "binaries/adb", "sidecar": true },
        { "name": "binaries/ws-scrcpy", "sidecar": true }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "binaries/qa-orchestrator", "sidecar": true },
        { "name": "binaries/adb", "sidecar": true },
        { "name": "binaries/ws-scrcpy", "sidecar": true }
      ]
    }
  ]
}
